# Normaliza finais de linha para LF no repositório (evita ruído CRLF/LF entre SO).
* text=auto eol=lf

# Arquivos binários não devem ser normalizados.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Banco SQLite ("save state" do CodeHub) — binário versionado no Git.
*.sqlite binary
