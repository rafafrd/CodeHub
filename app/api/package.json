{
  "name": "@codehub/api",
  "version": "2.0.0",
  "private": true,
  "description": "Backend da API do CodeHub (Node + TypeScript + Express).",
  "main": "dist/shared/http/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/shared/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/shared/http/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
